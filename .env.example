# Base URL of the speech backend. The client calls POST {VITE_API_URL}/api/tts
# In production (Vercel), set this to your Render URL, e.g. https://speakeasy-api.onrender.com
VITE_API_URL=http://localhost:5000

# false = skip the backend and use the browser's built-in speech (no download).
# VITE_USE_BACKEND=true
