# Port the speech service binds to. Must match VITE_API_URL in the client.
PORT=5000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Synthesis requests allowed per IP per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Longest passage accepted, in characters. Keep in step with MAX_CHARS in the client.
MAX_TEXT_LENGTH=5000

# Generated clips are deleted after this many minutes.
AUDIO_TTL_MINUTES=30

# How long to wait for the speech provider before giving up (504).
TTS_TIMEOUT_MS=20000

# --- Production only -------------------------------------------------------
# production: stop accepting any localhost origin; only CORS_ORIGIN is allowed.
# NODE_ENV=production
# Number of proxies in front of the app (1 on Render/Railway), so rate limits
# apply per visitor instead of to the proxy. Leave unset locally.
# TRUST_PROXY=1
